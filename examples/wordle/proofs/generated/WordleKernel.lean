/-- [wordle_kernel::step_core]:
    Source: 'examples/wordle/kernel/src/lib.rs', lines 298:0-357:1
    Visibility: public -/
def step_core
  (game : Core) (mv : Move) :
  Result (core.result.Result (Core × Phase) Error)
  := do
  if game.done
  then ok (core.result.Result.Err Error.Done)
  else
    if game.guess_count >= MAX_GUESSES
    then ok (core.result.Result.Err Error.Done)
    else
      if game.turn >= MAX_GUESSES
      then ok (core.result.Result.Err Error.Done)
      else
        let o ← invalid_reason game mv
        match o with
        | none =>
          let letters ← letters_of mv
          let marks ← mark game.secret letters
          let i ← MAX_GUESSES - game.turn
          let guesses_left ← i - 1#u8
          let i1 ← lift (UScalar.cast .Usize game.guess_count)
          let (_, index_mut_back) ← Array.index_mut_usize game.guesses i1
          let i2 ← game.guess_count + 1#u8
          let i3 ← game.turn + 1#u8
          let b ← all_green marks
          if b
          then
            let a := index_mut_back letters
            ok (core.result.Result.Ok
              ({
                 game
                   with
                   guesses := a,
                   guess_count := i2,
                   error_count := 0#u8,
                   turn := i3,
                   done := true,
                   won := true,
                   reward_milli := WIN_MILLI
               }, Phase.Played letters marks guesses_left PlayOutcome.Win))
          else
            if i2 >= MAX_GUESSES
            then
              let reward_milli ← completion_milli marks
              let a := index_mut_back letters
              ok (core.result.Result.Ok
                ({
                   game
                     with
                     guesses := a,
                     guess_count := i2,
                     error_count := 0#u8,
                     turn := i3,
                     done := true,
                     won := false,
                     reward_milli
                 }, Phase.Played letters marks guesses_left (PlayOutcome.Loss
                reward_milli)))
            else
              let a := index_mut_back letters
              ok (core.result.Result.Ok
                ({
                   game
                     with
                     guesses := a,
                     guess_count := i2,
                     error_count := 0#u8,
                     turn := i3,
                     reward_milli := 0#i64
                 }, Phase.Played letters marks guesses_left
                PlayOutcome.Ongoing))
        | some reason =>
          if game.error_count < ERROR_ALLOWANCE
          then
            let i ← game.error_count + 1#u8
            ok (core.result.Result.Ok
              ({ game with error_count := i, reward_milli := 0#i64 },
              Phase.Retry reason))
          else
            let reward_milli ← latest_completion game
            ok (core.result.Result.Ok
              ({ game with done := true, won := false, reward_milli },
              Phase.InvalidEnd reason reward_milli))

/-- [wordle_kernel::transition]:
    Source: 'examples/wordle/kernel/src/lib.rs', lines 360:0-396:1
    Visibility: public -/
def transition
  (_ : Unit) (game : Core) (cmd : Command) :
  Result (core.result.Result ((Option Core) × Reply) Error)
  := do
  match cmd with
  | Command.Reset secret =>
    let b ← is_word secret
    if b
    then
      let c ← fresh secret
      ok (core.result.Result.Ok (some c,
        { reward_milli := 0#i64, done := false, phase := none }))
    else ok (core.result.Result.Err Error.InvalidSecret)
  | Command.Step mv =>
    let r ← step_core game mv
    match r with
    | core.result.Result.Ok p =>
      let (next, phase) := p
      ok (core.result.Result.Ok (some next,
        {
          reward_milli := next.reward_milli,
          done := next.done,
          phase := (some phase)
        }))
    | core.result.Result.Err e => ok (core.result.Result.Err e)
  | Command.State =>
    ok (core.result.Result.Ok (none,
      { reward_milli := game.reward_milli, done := game.done, phase := none }))

