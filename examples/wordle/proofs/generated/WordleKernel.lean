    Source: 'examples/wordle/kernel/src/lib.rs', lines 260:0-278:1 -/
def invalid_reason (game : Core) (mv : Move) : Result (Option Reason) := do
  match mv with
  | Move.Candidate letters in_dictionary =>
    let b ← is_word letters
    if b
    then
      let b1 ← already_guessed game letters
      if b1
      then ok (some Reason.Repeat)
      else if in_dictionary
           then ok none
           else ok (some Reason.NotEnglish)
    else ok (some Reason.NotEnglish)
  | Move.Malformed reason => ok (some reason)

